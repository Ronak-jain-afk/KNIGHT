# SPDX-License-Identifier: Apache-2.0
# Server settings
KNIGHT_HOST=127.0.0.1
KNIGHT_PORT=8000
KNIGHT_DATA_DIR=./data

# Llama server settings
KNIGHT_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
KNIGHT_LLAMA_API_KEY=local
KNIGHT_MODEL_NAME=qwen3.5-4b
KNIGHT_CONTEXT_TOKENS=16384
KNIGHT_MAX_OUTPUT_TOKENS=1024
KNIGHT_TEMPERATURE=0.7
KNIGHT_TOP_P=0.8
KNIGHT_TOP_K=20
KNIGHT_PRESENCE_PENALTY=1.5
KNIGHT_ENABLE_THINKING=false

# GGUF model download hardening
KNIGHT_MODEL_DOWNLOAD_MAX_BYTES=21474836480
KNIGHT_MODEL_DOWNLOAD_HOSTS=huggingface.co

# Agent & summarization settings
KNIGHT_SUMMARY_TRIGGER_TOKENS=9000
KNIGHT_SUMMARY_KEEP_MESSAGES=8
KNIGHT_MAX_TOOL_CALLS_PER_TURN=8

# Web search & fetch settings
KNIGHT_SEARCH_PROVIDERS=ddgs,searxng,brave
KNIGHT_SEARXNG_URL=
KNIGHT_BRAVE_API_KEY=
KNIGHT_SEARCH_CACHE_TTL_HOURS=24
KNIGHT_PAGE_CACHE_TTL_HOURS=168
KNIGHT_FETCH_MAX_BYTES=2000000
KNIGHT_FETCH_TIMEOUT_SECONDS=12
KNIGHT_FETCH_MAX_CHARS=6000

# Memory settings
KNIGHT_MEMORY_ENABLED=true
KNIGHT_MEMORY_TOP_K=6
KNIGHT_MEMORY_MIN_SCORE=0.35
KNIGHT_MEMORY_AUTO_EXTRACT=true
KNIGHT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNIGHT_EMBEDDING_DIMS=384

# Security & logging settings
KNIGHT_AUTH_TOKEN=
KNIGHT_LOG_LEVEL=INFO
KNIGHT_LOG_PROMPTS=false
LANGSMITH_TRACING=false
KNIGHT_DEV=false


# <-- end of file -->
